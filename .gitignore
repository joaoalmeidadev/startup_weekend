# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle
/vendor/bundle

# Environment
.env
.env.*
!.env.example

# Logs and temp files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Active Storage
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Secrets
/config/master.key
/config/credentials/*.key

# Vite Ruby
/public/vite*
node_modules
*.local

# Editors / OS
.idea
.vscode
.DS_Store
