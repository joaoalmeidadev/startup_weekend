#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # Idempotent: safe to run at any time.
  puts "== Installing Ruby dependencies =="
  # Ruby 3.1 ships an old Bundler that can't read `ruby file:` in the Gemfile
  bundler_version = File.read("Gemfile.lock")[/BUNDLED WITH\n\s+(\S+)/, 1]
  system! "gem install bundler --conservative --no-document -v #{bundler_version}"
  system! "bundle config set --local path vendor/bundle"
  system("bundle check") || system!("bundle install")

  puts "\n== Installing JS dependencies =="
  system! "yarn install --frozen-lockfile"

  puts "\n== Preparing .env =="
  FileUtils.cp ".env.example", ".env" unless File.exist?(".env")

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Running health check =="
  system! "bin/doctor"

  puts "\n== Setup complete! Run 'make dev' to start the app =="
end
